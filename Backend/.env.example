# Copy to .env and fill in. The server reads the process environment.

# PostgreSQL. Required for accounts, Google sign-in, and word credits.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/humanly?sslmode=disable

# Google OAuth web client.
# Authorized redirect URI in Google Cloud must match this exactly, including https and path.
# It must be the site the browser is on, because the OAuth cookie is first-party.
# Local, where Next.js proxies /api to this server:
#   http://localhost:3000/api/v1/auth/google/callback
# Deployed site (the frontend origin, not the API host):
#   https://humanly-bee3e0.runex.cloud/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback

# Signs session cookies and the OAuth state. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string

# Browser origin. Google returns the writer here after sign-in.
HUMANLY_APP_URL=http://localhost:3000

# Set true behind HTTPS so the session cookie is marked Secure.
HUMANLY_COOKIE_SECURE=false

HUMANLY_ADDR=:8080
HUMANLY_DETECTOR_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the API directly.
# Leave empty in local development.
HUMANLY_ORIGINS=
